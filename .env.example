# Database. Local development uses a SQLite file; production uses Turso (libSQL).
#   local:  DATABASE_URL="file:./dev.db"
#   Turso:  DATABASE_URL="libsql://<db>-<org>.<region>.turso.io"  +  DATABASE_AUTH_TOKEN="<token>"
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# First administrator, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Set to "true" to also load demo departments, courses, students and admissions
SEED_DEMO="false"
