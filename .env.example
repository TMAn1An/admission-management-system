# Database. Local development uses a SQLite file; production uses Turso (libSQL).
#   local:  DATABASE_URL="file:./dev.db"
#   Turso:  DATABASE_URL="libsql://<db>-<org>.<region>.turso.io"  +  DATABASE_AUTH_TOKEN="<token>"
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# First administrator, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Set to "true" to also load demo departments, courses, students and admissions
SEED_DEMO="false"

# --- Optional: transactional email (Resend, https://resend.com) --------------------------------
# Enables application/decision/receipt emails and "Forgot password". Without these the features stay hidden.
RESEND_API_KEY=""
MAIL_FROM="Admissions <admissions@your-domain.com>"

# --- Optional: online fee payment (SSLCommerz: bKash, Nagad, cards) -----------------------------
# Get sandbox keys at https://developer.sslcommerz.com ; set SSLCOMMERZ_LIVE=true only with live keys.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_LIVE="false"

# --- Branding / links -------------------------------------------------------------------------
INSTITUTION_NAME="Admission Office"
# Public URL used in emails and payment callbacks. On Vercel it is detected automatically.
APP_URL=""

# --- Development only (ignored in production) -------------------------------------------------
# PAYMENT_MOCK="true"    # simulated payment gateway page
# MAIL_TRANSPORT="log"   # print emails to the server log
