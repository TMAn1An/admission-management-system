# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admissions"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# First administrator, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"

# Set to "true" to also load demo departments, courses, students and admissions
SEED_DEMO="false"
